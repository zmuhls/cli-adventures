{
  "name": "cli-adventures",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "workers_dev": true,
  "vars": {
    "RELEASE": "dev",
    // Bit and the in-game agent call this OpenAI-compatible gateway. The key is the
    // CAIL_GATEWAY_API_KEY secret (an app sk-cail-* key); without it the game uses scripted lines.
    "CAIL_GATEWAY_URL": "https://tools.ailab.gc.cuny.edu/v1",
    "LLM_MODEL": "gemma-4-26b-a4b-it"
  },
  // Per-visitor cap on /api/llm (requests per 60 seconds)
  "ratelimits": [
    {
      "name": "LLM_LIMITER",
      "namespace_id": "4520",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
