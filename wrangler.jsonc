{
  "name": "cli-adventures",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "workers_dev": true,
  "vars": {
    "RELEASE": "dev",
    // Bit and the in-game agent call this OpenAI-compatible gateway. The key is the
    // CAIL_GATEWAY_API_KEY secret (an app sk-cail-* key); without it the game uses scripted lines.
    "CAIL_GATEWAY_URL": "https://tools.ailab.gc.cuny.edu/v1",
    "LLM_MODEL": "deepseek-v4-flash-0731",
    // Sign-in and saved progress only answer on this exact origin.
    "PUBLIC_ORIGIN": "https://cli-adventures.ailab-452.workers.dev"
  },
  // CUNY sign-in through Doorway, and saved progress in the Lab's shared My work store.
  // Both are private Worker-to-Worker bindings; the props are this deployment's identity there.
  "services": [
    { "binding": "IDENTITY", "service": "cail-doorway", "entrypoint": "WorkerIdentity", "props": { "id": "cli-adventures", "worker": "cli-adventures", "workspace": false } },
    { "binding": "WORK_ACCOUNTS", "service": "cail-work-accounts", "entrypoint": "WorkerAccounts", "props": {
      "id": "cli-adventures", "worker": "cli-adventures", "version": 1, "workerRoutes": true,
      "name": "CLI Adventures", "description": "Learn the command line, then put an AI agent to work in it.", "kind": "progress",
      "href": "/", "resumePath": "/"
    } }
  ],
  // Per-visitor cap on /api/llm (requests per 60 seconds)
  "ratelimits": [
    {
      "name": "LLM_LIMITER",
      "namespace_id": "4520",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
